# Stage 1: Build
FROM node:20-alpine AS build

WORKDIR /app

COPY N4-Basestation/package*.json ./
RUN npm install

COPY N4-Basestation/. .

ARG VITE_MQTT_HOST=localhost
ARG VITE_WS_PORT=1783
ARG VITE_BACKEND_URL=http://localhost:5001
ARG VITE_VIDEO_URL=

RUN printf 'VITE_MQTT_HOST=%s\nVITE_WS_PORT=%s\nVITE_BACKEND_URL=%s\nVITE_VIDEO_URL=%s\n' \
    "$VITE_MQTT_HOST" "$VITE_WS_PORT" "$VITE_BACKEND_URL" "$VITE_VIDEO_URL" > .env

RUN npm run build

# Stage 2: Serve
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY Docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
